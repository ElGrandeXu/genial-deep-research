{
  "name": "genial-deep-research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Boucle verticale de recherche publique sourcée de Génial",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "node tools/run-next.mjs dev",
    "build": "node tools/run-next.mjs build",
    "start": "node tools/run-next.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node tools/contract-types.mjs --check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse:check": "node tools/check-lighthouse.mjs",
    "contract:types": "node tools/contract-types.mjs --write",
    "contract:types:check": "node tools/contract-types.mjs --check",
    "verify": "pwsh -NoProfile -File tools/verify-project.ps1"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.47",
    "ai": "7.0.79",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.3",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "json-schema-to-typescript": "15.0.4",
    "lighthouse": "13.4.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
